SPRING_PROFILES_ACTIVE=local

# Application database (not the postgres superuser)
DB_URL=jdbc:postgresql://localhost:5432/user_service_db
DB_USERNAME=innowise_app
DB_PASSWORD=change-me-app

REDIS_HOST=localhost
REDIS_PORT=6379
SERVER_PORT=8080

# Docker Compose: postgres superuser (init only, not used by the app)
POSTGRES_DB=user_service_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin

# Created by docker/postgres/init/01-create-app-user.sh
APP_DB_USERNAME=innowise_app
APP_DB_PASSWORD=change-me-app
